<?xml version="1.0"?>
<ruleset name="OA Dues Lookup">
  <description>PHP_CodeSniffer rules for WordPress plugin development.</description>

  <arg name="basepath" value="."/>
  <arg name="colors"/>
  <arg value="p"/>

  <file>oadueslookup.php</file>
  <file>includes</file>
  <file>bin</file>

  <exclude-pattern>*/vendor/*</exclude-pattern>

  <!-- Keep runtime and review concerns visible without enforcing formatting or docs. -->
  <rule ref="WordPress.Security"/>
  <rule ref="WordPress.DB"/>
  <rule ref="WordPress.WP.I18n"/>
  <rule ref="WordPress.WP.EnqueuedResourceParameters"/>
  <rule ref="WordPress.WP.AlternativeFunctions"/>
  <rule ref="WordPress.PHP.DiscouragedPHPFunctions"/>
  <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
    <properties>
      <property name="prefixes" type="array">
        <element value="oadueslookup"/>
        <element value="oalm"/>
        <element value="oa_tools"/>
      </property>
    </properties>
  </rule>
  <rule ref="Generic.PHP.ForbiddenFunctions"/>
</ruleset>